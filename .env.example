# Copy to .env. Never commit real robot addresses, keys, or credentials.
OPENROBOOPS_DATABASE_URL=postgresql+asyncpg://openroboops:change-me@postgres:5432/openroboops
OPENROBOOPS_COOKIE_SECURE=true
OPENROBOOPS_ALLOWED_ORIGINS=https://openroboops.local
OPENROBOOPS_DATA_ROOT=/data/episodes
OPENROBOOPS_DATA_ROOT_HOST=./data
OPENROBOOPS_SECRETS_HOST=./runtime-secrets
OPENROBOOPS_SEED_SIMULATOR=true
OPENROBOOPS_POLL_INTERVAL_SECONDS=5
OPENROBOOPS_PERSIST_INTERVAL_SECONDS=30
OPENROBOOPS_SITE_ADDRESS=https://localhost
# Hostname or IP only. This is also used when a client omits TLS SNI.
OPENROBOOPS_SITE_HOST=localhost
OPENROBOOPS_HTTP_PORT=8080
OPENROBOOPS_HTTPS_PORT=8443
POSTGRES_PASSWORD=change-me
